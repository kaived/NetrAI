ENVIRONMENT=development
APP_NAME=RetinaScan AI API
API_CORS_ORIGINS=http://localhost:5173

GCP_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIRESTORE_ENABLED=false
FIRESTORE_CASES_COLLECTION=cases
GCS_ENABLED=false
GCS_INPUT_BUCKET=
GCS_OUTPUT_BUCKET=

INFERENCE_MODE=stub
MODEL_VERSION=demo-stub-v0
MODEL_PATH=models/dr_classifier.onnx
MODEL_GCS_URI=
MODEL_INPUT_SIZE=224
MODEL_OUTPUT_FORMAT=logits
MODEL_CHANNEL_ORDER=rgb
MODEL_LAYOUT=auto
MODEL_INPUT_SCALE=0_1
MODEL_APPLY_CLAHE=true
QUALITY_MIN_FOCUS_SCORE=120
QUALITY_MIN_BRIGHTNESS=0.15
QUALITY_MAX_BRIGHTNESS=0.90
QUALITY_MIN_CONTRAST=0.05

LOCAL_STORAGE_DIR=runtime_storage
