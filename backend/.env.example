ENVIRONMENT=development
APP_NAME=RetinaScan AI API
API_CORS_ORIGINS=http://localhost:5173,https://netr-ai.orbionixtech.com,https://www.netr-ai.orbionixtech.com,https://localhost,capacitor://localhost
# Optional pilot API gate. Leave empty for local development.
API_ACCESS_KEY=

GCP_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIRESTORE_ENABLED=false
FIRESTORE_CASES_COLLECTION=cases
GCS_ENABLED=false
GCS_INPUT_BUCKET=
GCS_OUTPUT_BUCKET=

INFERENCE_MODE=stub
MODEL_VERSION=demo-stub-v0
MODEL_PATH=models/dr_classifier.onnx
MODEL_GCS_URI=
MODEL_INPUT_SIZE=224
MODEL_OUTPUT_FORMAT=probabilities
MODEL_CHANNEL_ORDER=rgb
MODEL_LAYOUT=auto
MODEL_INPUT_SCALE=0_1
MODEL_APPLY_CLAHE=true
MODEL_REFERABLE_THRESHOLD=0.50
QUALITY_MIN_FOCUS_SCORE=0.75
QUALITY_MIN_BRIGHTNESS=0.10
QUALITY_MAX_BRIGHTNESS=0.90
QUALITY_MIN_CONTRAST=0.05
QUALITY_MIN_COMPATIBILITY_SCORE=0.55
QUALITY_MAX_EDGE_ARTIFACT_RATIO=0.52
QUALITY_MAX_GREEN_DOMINANCE_RATIO=0.42

LOCAL_STORAGE_DIR=runtime_storage
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_PIXELS=25000000
